      "isDeleted": true,
      "boundElements": [],
      "updated": 1783619829899,
      "link": null,
      "locked": false,
      "text": "> Just a minimal one line hint\nstring in the corner rendered\nover the content window's\nborder (remeber content \nalways has solid border \nto give some clarity padding\n> Pressing menu just like in \nthe case above, makes \nfocusable and focuses menu\n(and in this context shows\nit as well as it was hidden) \nwhere normal actions are \navailable",
      "fontSize": 15.478312631359247,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "> Just a minimal one line hint\nstring in the corner rendered\nover the content window's\nborder (remeber content \nalways has solid border \nto give some clarity padding\n> Pressing menu just like in \nthe case above, makes \nfocusable and focuses menu\n(and in this context shows\nit as well as it was hidden) \nwhere normal actions are \navailable",
      "autoResize": true,
      "lineHeight": 1.25
    },
