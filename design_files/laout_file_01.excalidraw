      "boundElements": [],
      "updated": 1783604310033,
      "link": null,
      "locked": false,
      "text": "List displays  formatted\nand aligned in columns\n> files, commands run \nin terminal and shells\nall color coded lines to \nnot have to order them\nor introduce redundant\nnewline spacers for\nspace efficiency.\n> additionally first col\ndisplays one of 3 icons\nfrom nerdfont (will try \nto come up with unicode\nfallbacks to identify type\nof a poppy. \n> Indexes padded to be\nright-aligned\n> Plain text clear simple \ntitle up the top delimited\nwith a separator made of\nboxdrawing vert chars",
      "fontSize": 15.478312631359247,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "List displays  formatted\nand aligned in columns\n> files, commands run \nin terminal and shells\nall color coded lines to \nnot have to order them\nor introduce redundant\nnewline spacers for\nspace efficiency.\n> additionally first col\ndisplays one of 3 icons\nfrom nerdfont (will try \nto come up with unicode\nfallbacks to identify type\nof a poppy. \n> Indexes padded to be\nright-aligned\n> Plain text clear simple \ntitle up the top delimited\nwith a separator made of\nboxdrawing vert chars",
      "autoResize": true,
      "lineHeight": 1.25
    },
